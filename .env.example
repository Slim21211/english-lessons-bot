# ============================================================================
# Всё из этого блока переносится в Vercel → Settings → Environment Variables
# ============================================================================

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Любая случайная строка 16+ символов из A-Z a-z 0-9 _ - (например: openssl rand -hex 24)
TELEGRAM_WEBHOOK_SECRET=
# Telegram id пользователей через запятую (у каждого свои занятия, остальным бот отказывает).
# Не знаете id — пусть человек напишет боту что угодно, бот ответит его id
ALLOWED_TELEGRAM_IDS=

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Секрет для вызова /api/tick из pg_cron (openssl rand -hex 24)
TICK_SECRET=

# Groq — разбор свободного текста (https://console.groq.com/keys).
# Без ключа бот понимает только команды и простые фразы.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=12000

# Поведение (здесь значения по умолчанию — можно не переносить, если не меняете)
TIME_ZONE=Europe/Moscow
PACK_SIZE=4
DEFAULT_DURATION_MIN=60
MORNING_HOUR=10
POST_LESSON_DELAY_MIN=10
PAY_REMIND_THRESHOLD=1
PAY_REMIND_HOUR=12
WEEKLY_DIGEST=on
WEEKLY_DIGEST_HOUR=20
# Напоминания о ДЗ: накануне в HOMEWORK_HOUR и за сутки, в день занятия в HOMEWORK_HOUR и за 2 часа
HOMEWORK_REMINDERS=on
HOMEWORK_HOUR=9
# Через сколько часов считать неотмеченное занятие состоявшимся (0 — никогда)
AUTO_DONE_AFTER_HOURS=0
HORIZON_DAYS=28

# Необязательно: свой Bot API сервер или прокси
# TELEGRAM_API_ROOT=

# ============================================================================
# Только локально (npm run prod / dev / db:push) — в Vercel НЕ нужны
# ============================================================================

# Прод-адрес Vercel, например https://english-lessons-bot.vercel.app
APP_URL=
# Supabase → Project Settings → General → Reference ID
SUPABASE_PROJECT_REF=
# Пароль БД (иначе supabase CLI спросит при npm run db:push)
SUPABASE_DB_PASSWORD=
