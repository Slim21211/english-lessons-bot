# --- Обязательные ---

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Любая случайная строка 16+ символов из A-Z a-z 0-9 _ - (например: openssl rand -hex 24)
TELEGRAM_WEBHOOK_SECRET=
# Ваш Telegram id. Не знаете — напишите боту что угодно, он ответит вашим id
OWNER_TELEGRAM_ID=

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Секрет для вызова /api/tick из pg_cron (openssl rand -hex 24)
TICK_SECRET=

# --- Модель для разбора свободного текста (хотя бы один провайдер, иначе работают только команды и простые фразы) ---

LLM_PROVIDERS=groq,openrouter
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# openrouter/free сам выбирает доступную бесплатную модель; можно перечислить несколько через запятую
OPENROUTER_MODELS=openrouter/free
# Любой OpenAI-совместимый endpoint, если добавить "custom" в LLM_PROVIDERS
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
LLM_TIMEOUT_MS=12000

# --- Поведение (значения по умолчанию) ---

TIME_ZONE=Europe/Moscow
PACK_SIZE=4
DEFAULT_DURATION_MIN=60
MORNING_HOUR=10
POST_LESSON_DELAY_MIN=10
PAY_REMIND_THRESHOLD=1
PAY_REMIND_HOUR=12
WEEKLY_DIGEST=on
WEEKLY_DIGEST_HOUR=20
# Через сколько часов считать неотмеченное занятие состоявшимся (0 — никогда)
AUTO_DONE_AFTER_HOURS=0
HORIZON_DAYS=28
