{
  "name": "english-lessons-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Личный Telegram-бот: учёт оплаченных занятий английским, подтверждение занятий и напоминания об оплате",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "tick:local": "node --env-file=.env --env-file-if-exists=.env.local --import tsx scripts/tick-local.ts",
    "dev": "node --env-file=.env --env-file-if-exists=.env.local --import tsx scripts/dev.ts",
    "prod": "node --env-file=.env --import tsx scripts/prod.ts",
    "db:push": "node --env-file=.env --import tsx scripts/db-push.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "grammy": "^1.46.0",
    "luxon": "^3.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
